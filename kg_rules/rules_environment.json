{
  "module_id": "environment",
  "rules": [
    {
      "id": "E020",
      "priority": 80,
      "type": "soft",
      "group": "ENV_LIGHT",
      "when": {
        "all": [
          {
            "fact": "env.light_min",
            "op": "rank_gte",
            "value_ref": "plant.light_min",
            "rank_map": "LIGHT_RANK"
          },
          {
            "fact": "env.light_max",
            "op": "rank_lte",
            "value_ref": "plant.light_max",
            "rank_map": "LIGHT_RANK"
          }
        ]
      },
      "then": {
        "action": "UPRANK",
        "delta": 15,
        "reason_code": "LIGHT_MATCH",
        "explanation_template": "집의 광환경이 {plant.name_ko}가 좋아하는 빛 조건과 잘 맞아서 점수를 올렸어요.",
        "evidence": [
          {
            "field": "plants.light_min",
            "value_ref": "plant.light_min"
          },
          {
            "field": "plants.light_max",
            "value_ref": "plant.light_max"
          }
        ]
      }
    },
    {
      "id": "E021",
      "priority": 75,
      "type": "soft",
      "group": "ENV_LIGHT",
      "when": {
        "all": [
          {
            "fact": "env.direct_sun",
            "op": "rank_lte",
            "value_ref": "plant.direct_sun",
            "rank_map": "DIRECT_SUN_RANK"
          }
        ]
      },
      "then": {
        "action": "UPRANK",
        "delta": 5,
        "reason_code": "SUN_MATCH",
        "explanation_template": "직사광 조건이 {plant.name_ko}의 내성과 잘 맞아요.",
        "evidence": [
          {
            "field": "plants.direct_sun",
            "value_ref": "plant.direct_sun"
          }
        ]
      }
    },
    {
      "id": "E030",
      "priority": 70,
      "type": "soft",
      "group": "ENV_LIGHT",
      "when": {
        "all": [
          {
            "fact": "env.window_distance",
            "op": "rank_eq",
            "value_ref": "plant.window_distance",
            "rank_map": "WINDOW_DIST_RANK"
          }
        ]
      },
      "then": {
        "action": "UPRANK",
        "delta": 6,
        "reason_code": "DIST_MATCH",
        "explanation_template": "창문과의 거리 조건이 {plant.name_ko} 권장 범위랑 비슷해서 좋아요.",
        "evidence": [
          {
            "field": "plants.window_distance",
            "value_ref": "plant.window_distance"
          }
        ]
      }
    },
    {
      "id": "E040",
      "priority": 65,
      "type": "soft",
      "group": "ENV_TEMP",
      "when": {
        "all": [
          {
            "fact": "env.temp_min_c",
            "op": ">=",
            "value_ref": "plant.temp_min_c"
          },
          {
            "fact": "env.temp_max_c",
            "op": "<=",
            "value_ref": "plant.temp_max_c"
          }
        ]
      },
      "then": {
        "action": "UPRANK",
        "delta": 10,
        "reason_code": "TEMP_MATCH",
        "explanation_template": "실내 온도 범위가 {plant.name_ko}의 적정 온도와 잘 맞아요.",
        "evidence": [
          {
            "field": "plants.temp_min_c",
            "value_ref": "plant.temp_min_c"
          },
          {
            "field": "plants.temp_max_c",
            "value_ref": "plant.temp_max_c"
          }
        ]
      }
    },
    {
      "id": "E050",
      "priority": 60,
      "type": "soft",
      "group": "ENV_HUMID",
      "when": {
        "all": [
          {
            "fact": "env.humidity_pref",
            "op": "==",
            "value_ref": "plant.humidity_pref"
          }
        ]
      },
      "then": {
        "action": "UPRANK",
        "delta": 6,
        "reason_code": "HUMID_MATCH",
        "explanation_template": "실내 습도 성향이 {plant.name_ko} 선호도랑 잘 맞아요.",
        "evidence": [
          {
            "field": "plants.humidity_pref",
            "value_ref": "plant.humidity_pref"
          }
        ]
      }
    },
    {
      "id": "E060",
      "priority": 58,
      "type": "soft",
      "group": "ENV_SPACE",
      "when": {
        "all": [
          {
            "fact": "plant.recommended_space",
            "op": "contains",
            "value_ref": "env.space_type"
          }
        ]
      },
      "then": {
        "action": "UPRANK",
        "delta": 8,
        "reason_code": "SPACE_MATCH",
        "explanation_template": "{plant.name_ko}는 배치 공간({env.space_type})에 잘 어울리는 편이라 점수를 올렸어요.",
        "evidence": [
          {
            "field": "plants.recommended_space",
            "value_ref": "plant.recommended_space"
          }
        ]
      }
    },
    {
      "id": "E022",
      "priority": 77,
      "type": "soft",
      "group": "ENV_LIGHT",
      "when": {
        "all": [
          {
            "fact": "env.light_max",
            "op": "rank_lt",
            "value_ref": "plant.light_min",
            "rank_map": "LIGHT_RANK"
          }
        ]
      },
      "then": {
        "action": "DOWNRANK",
        "delta": -18,
        "reason_code": "LIGHT_TOO_LOW",
        "explanation_template": "집의 광량이 {plant.name_ko}가 필요로 하는 최소 광량보다 낮아서 추천 우선순위를 내렸어요.",
        "evidence": [
          {
            "field": "env.light_max",
            "value_ref": "env.light_max"
          },
          {
            "field": "plants.light_min",
            "value_ref": "plant.light_min"
          }
        ]
      }
    },
    {
      "id": "E031",
      "priority": 69,
      "type": "soft",
      "group": "ENV_LIGHT",
      "when": {
        "any": [
          {
            "all": [
              {
                "fact": "plant.window_distance",
                "op": "==",
                "value": "0~50cm"
              },
              {
                "fact": "env.window_distance",
                "op": "in",
                "value": [
                  "0~50cm",
                  "50~150cm"
                ]
              }
            ]
          },
          {
            "all": [
              {
                "fact": "plant.window_distance",
                "op": "==",
                "value": "50~150cm"
              },
              {
                "fact": "env.window_distance",
                "op": "in",
                "value": [
                  "0~50cm",
                  "50~150cm",
                  "150~300cm"
                ]
              }
            ]
          },
          {
            "all": [
              {
                "fact": "plant.window_distance",
                "op": "==",
                "value": "150~300cm"
              },
              {
                "fact": "env.window_distance",
                "op": "in",
                "value": [
                  "50~150cm",
                  "150~300cm",
                  "300cm+"
                ]
              }
            ]
          },
          {
            "all": [
              {
                "fact": "plant.window_distance",
                "op": "==",
                "value": "300cm+"
              },
              {
                "fact": "env.window_distance",
                "op": "in",
                "value": [
                  "150~300cm",
                  "300cm+"
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "action": "UPRANK",
        "delta": 3,
        "reason_code": "DIST_NEAR_MATCH",
        "explanation_template": "창문 거리 조건이 {plant.name_ko} 권장 범위와 거의 비슷해서 무난하게 잘 맞아요.",
        "evidence": [
          {
            "field": "env.window_distance",
            "value_ref": "env.window_distance"
          },
          {
            "field": "plants.window_distance",
            "value_ref": "plant.window_distance"
          }
        ]
      }
    },
    {
      "id": "E051",
      "priority": 59,
      "type": "soft",
      "group": "ENV_TEMP",
      "when": {
        "any": [
          {
            "fact": "env.temp_min_c",
            "op": "<",
            "value_ref": "plant.temp_min_c"
          },
          {
            "fact": "env.temp_max_c",
            "op": ">",
            "value_ref": "plant.temp_max_c"
          }
        ]
      },
      "then": {
        "action": "DOWNRANK",
        "delta": -15,
        "reason_code": "TEMP_MISMATCH",
        "explanation_template": "실내 온도 범위가 {plant.name_ko} 적정 범위를 벗어날 수 있어 점수를 낮췄어요.",
        "evidence": [
          {
            "field": "env.temp_min_c",
            "value_ref": "env.temp_min_c"
          },
          {
            "field": "env.temp_max_c",
            "value_ref": "env.temp_max_c"
          },
          {
            "field": "plants.temp_min_c",
            "value_ref": "plant.temp_min_c"
          },
          {
            "field": "plants.temp_max_c",
            "value_ref": "plant.temp_max_c"
          }
        ]
      }
    }
  ]
}
