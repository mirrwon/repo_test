{
  "module_id": "style",
  "rules": [
    {
      "id": "ST001",
      "priority": 40,
      "type": "soft",
      "group": "STYLE",
      "when": {
        "all": [
          { "fact": "user.style_likes", "op": "overlap_any", "value_ref": "plant.style_tags" }
        ]
      },
      "then": {
        "action": "UPRANK",
        "delta": 10,
        "reason_code": "STYLE_MATCH",
        "explanation_template": "선호한 스타일 태그와 {plant.name_ko} 분위기가 비슷해서 더 추천했어요.",
        "evidence": [
          { "field": "plants.style_tags", "value_ref": "plant.style_tags" },
          { "field": "user_profile.style_likes", "value_ref": "user.style_likes" }
        ]
      }
    }
  ]
}
